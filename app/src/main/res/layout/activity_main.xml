<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_launcher_custom"
                android:layout_marginEnd="10dp"
                android:contentDescription="Rosin Ready Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROSIN READY"
                android:textColor="#4CAF50"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutApiKeySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tip: Setting up a free Gemini API key takes under a minute at ://google.com and unlocks Google AI vision to inspect your trichome photos directly. (No key or offline? Use the 3-option visual selector below)."
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Paste Gemini API Key Here (Auto-Hides Once Saved)"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#1E1E1E"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnWholeBud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+ Whole Bud Photo"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSplitBud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+ Inner Core Photo"
                android:layout_marginStart="6dp"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivWholeBud"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#1E1E1E"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ivSplitBud"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#1E1E1E"
                android:scaleType="centerCrop" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Internet required for AI photo scan. If offline, select visual trichome look below:"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgOfflineVisual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbOffHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Offline: Heavy Frost / Sticky Heads"
                android:textColor="#E0E0E0" />

            <RadioButton
                android:id="@+id/rbOffMed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Offline: Average Frost / Slightly Aged"
                android:textColor="#E0E0E0" />

            <RadioButton
                android:id="@+id/rbOffLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Offline: Poor Frost / Dark or Degraded"
                android:textColor="#E0E0E0" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbVacPacked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vac-Packed / Compressed (Discount outer shear)"
            android:checked="true"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/cbCanHydrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="I Can Hydrate (Stone + 62% Pack)"
                android:checked="false"
                android:textColor="#81C784" />

            <Button
                android:id="@+id/btnBeginnerGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUIDE"
                android:backgroundTint="#37474F"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbCheckStrain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Strain &amp; Bag Authenticity (Optional)"
            android:checked="false"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layoutStrainDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etClaimedStrain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Claimed Strain Name"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnBagPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Packaging / Mylar Photo (Optional)"
                android:backgroundTint="#455A64"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <ImageView
                android:id="@+id/ivBagPhoto"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#1E1E1E"
                android:scaleType="centerCrop" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Moisture / Tactile Feel:"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgMoisture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbDry1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bone dry / crispy (&lt;50% RH)"
                android:textColor="#E0E0E0" />

            <RadioButton
                android:id="@+id/rbDry2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dry outer, stiff stem (50-54% RH)"
                android:textColor="#E0E0E0" />

            <RadioButton
                android:id="@+id/rbDry3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Borderline dry (55-58% RH)"
                android:textColor="#E0E0E0" />

            <RadioButton
                android:id="@+id/rbDry4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Some sticky resin, not up to prime 62% humidity"
                android:textColor="#E0E0E0" />

            <RadioButton
                android:id="@+id/rbDry5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already at ~62% prime humidity (Springy / Stem bends and snaps)"
                android:checked="true"
                android:textColor="#E0E0E0" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvTerpLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terpene Intensity: 3.0 - Reasonable terp smell, not waking the neighbours"
            android:textColor="#FFB74D"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbTerps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="20"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etSmellProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dominant Smell (e.g., Cheese, Gas, Citrus, Hay)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="4dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Weight"
                app:suffixText="g"
                app:suffixTextColor="#81C784"
                android:textColorHint="#888888"
                android:layout_marginEnd="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:background="#1E1E1E" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Bud Width"
                app:suffixText="mm"
                app:suffixTextColor="#81C784"
                android:textColorHint="#888888"
                android:layout_marginStart="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDiameter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:background="#1E1E1E" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip: Break buds down into roughly equal sizes so moisture equalizes evenly across the whole batch."
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <ProgressBar
                android:id="@+id/progressAi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvWaitWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Analyzing trichomes &amp; core structure... Please wait 1–2 mins."
                android:textColor="#FFD54F"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRunAssessment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RUN PRESSING ASSESSMENT"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:padding="14dp"
            android:text="Load photos (or pick offline visual look) and enter batch details to run assessment."
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOG ACTUAL PRESS RESULT"
            android:textColor="#64B5F6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your actual yields below. The engine logs and learns from your results to constantly calibrate and improve future predictions."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1st Press\nYield (grams)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:suffixText="g"
                    app:suffixTextColor="#81C784">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVirginYield"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:background="#1E1E1E" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2nd Press\nYield (grams)"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:suffixText="g"
                    app:suffixTextColor="#81C784">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecondYield"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:background="#1E1E1E" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/etActualColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Actual Color &amp; Quality (e.g., Clean Golden, Amber, Dark)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="#1E1E1E"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnLogOutcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE OUTCOME TO ENGINE MEMORY"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
